{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base"
  ],
  "labels": [
    "dependencies"
  ],
  "draftPR": true,
  "baseBranches": [
    "staging"
  ],
  "rebaseWhen": "conflicted",
  "prHourlyLimit": 10,
  "packageRules": [
    {
      "matchPaths": [
        "server/application-server/**"
      ],
      "labels": [
        "application-server"
      ]
    },
    {
      "matchPaths": [
        "server/notification/**"
      ],
      "labels": [
        "notification-server"
      ]
    },
    {
      "matchPaths": [
        "server/webhook-listener/**"
      ],
      "labels": [
        "webhook-listener"
      ]
    },
    {
      "matchPaths": [
        "client/**"
      ],
      "labels": [
        "client"
      ]
    },
    {
      "matchPaths": [
        "keycloakify/**"
      ],
      "labels": [
        "keycloakify"
      ]
    },
    {
      "matchPaths": [
        "docs/**"
      ],
      "labels": [
        "documentation"
      ]
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "labels": [
        "docker"
      ]
    },
    {
      "matchPackagePatterns": [
        "*"
      ],
      "matchPaths": [
        "server/application-server/**"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "all non-major application-server dependencies",
      "groupSlug": "all-minor-patch-application-server"
    },
    {
      "matchPackagePatterns": [
        "*"
      ],
      "matchPaths": [
        "server/notification/**"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "all non-major notification-server dependencies",
      "groupSlug": "all-minor-patch-notification-server"
    },
    {
      "matchPackagePatterns": [
        "*"
      ],
      "matchPaths": [
        "server/webhook-listener/**"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "all non-major webhook-listener dependencies",
      "groupSlug": "all-minor-patch-webhook-listener"
    },
    {
      "matchPackagePatterns": [
        "*"
      ],
      "matchPaths": [
        "client/**"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "all non-major client dependencies",
      "groupSlug": "all-minor-patch-client"
    },
    {
      "matchPackagePatterns": [
        "*"
      ],
      "matchPaths": [
        "keycloakify/**"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "all non-major keycloakify dependencies",
      "groupSlug": "all-minor-patch-keycloakify"
    },
    {
      "matchPackagePatterns": [
        "*"
      ],
      "matchPaths": [
        "docs/**"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "all non-major documentation dependencies",
      "groupSlug": "all-minor-patch-documentation"
    },
    {
      "matchPackagePatterns": [
        "*"
      ],
      "matchPaths": [
        ".github/workflows/**"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "all non-major github-actions dependencies",
      "groupSlug": "all-minor-patch-github-actions"
    },
    {
      "description": "sphinx-rtd-theme 3.1 requires docutils <0.23; retain the theme's supported range.",
      "matchPackageNames": [
        "docutils"
      ],
      "allowedVersions": "<0.23"
    },
    {
      "description": "PrimeNG 22 is excluded by the project licensing constraint; retain the 21.x line.",
      "matchPackageNames": [
        "primeng"
      ],
      "allowedVersions": "<22"
    },
    {
      "description": "Angular 22 and typescript-eslint 8 require TypeScript below 6.1.",
      "matchPackageNames": [
        "typescript"
      ],
      "allowedVersions": "<6.1"
    },
    {
      "description": "PrimeIcons 8 uses the same new PrimeUI licensing model excluded for PrimeNG 22.",
      "matchPackageNames": [
        "primeicons"
      ],
      "allowedVersions": "<8"
    }
  ]
}
